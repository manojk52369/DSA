class Solution {
public:
    int minSteps(vector<int>& arr, int start, int end) {
        if (start == end)
            return 0;

        vector<int> dist(1000, -1);
        queue<int> q;

        q.push(start);
        dist[start] = 0;

        while (!q.empty()) {
            int curr = q.front();
            q.pop();

            for (int x : arr) {
                int next = (curr * x) % 1000;

                if (dist[next] == -1) {
                    dist[next] = dist[curr] + 1;

                    if (next == end)
                        return dist[next];

                    q.push(next);
                }
            }
        }

        return -1;
    }
};