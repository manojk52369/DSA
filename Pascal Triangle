class Solution {
public:
    vector<int> nthRowOfPascalTriangle(int n) {

        vector<int> ans;

        long long curr = 1;
        int row = n - 1;

        for (int i = 0; i <= row; i++) {
            ans.push_back(curr);

            curr = curr * (row - i) / (i + 1);
        }

        return ans;
    }
};