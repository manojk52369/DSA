class Solution {
public:
    bool pythagoreanTriplet(vector<int>& arr) {
        vector<int> present(1001, 0);

        for (int x : arr)
            present[x] = 1;

        vector<int> nums;
        for (int i = 1; i <= 1000; i++) {
            if (present[i])
                nums.push_back(i);
        }

        vector<int> sq(1000001, 0);

        for (int x : nums)
            sq[x * x] = 1;

        int m = nums.size();

        for (int i = 0; i < m; i++) {
            for (int j = i; j < m; j++) {
                int sum = nums[i] * nums[i] +
                          nums[j] * nums[j];

                if (sum <= 1000000 && sq[sum])
                    return true;
            }
        }

        return false;
    }
};