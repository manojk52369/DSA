class Solution {
public:
    int findMin(vector<int> &arr) {
        int low = 0, high = arr.size() - 1;

        while (low < high) {
            // Array is already sorted
            if (arr[low] < arr[high])
                return arr[low];

            int mid = low + (high - low) / 2;

            if (arr[mid] >= arr[low]) {
                // Minimum is in the right half
                low = mid + 1;
            } else {
                // Minimum is in the left half (including mid)
                high = mid;
            }
        }

        return arr[low];
    }
};