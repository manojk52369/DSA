class Solution {
public:
    int countZeroes(int x) {
        int cnt = 0;
        while (x > 0) {
            x /= 5;
            cnt += x;
        }
        return cnt;
    }

    int findNum(int n) {
        int low = 1, high = 5 * n;
        int ans = high;

        while (low <= high) {
            int mid = low + (high - low) / 2;

            if (countZeroes(mid) >= n) {
                ans = mid;
                high = mid - 1;
            } else {
                low = mid + 1;
            }
        }

        return ans;
    }
};