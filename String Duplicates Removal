class Solution {
public:
    string removeDuplicates(string &s) {
        string result = "";
        bool seen[256] = {false};
        
        for (char c : s) {
            if (!seen[(unsigned char)c]) {
                seen[(unsigned char)c] = true; 
                result += c;                  
            }
        }
        
        return result;
    }
};