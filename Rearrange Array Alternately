class Solution {
public:
    void rearrange(vector<int> &arr) {
        sort(arr.begin(), arr.end());

        int n = arr.size();

        long long maxElem = arr[n - 1] + 1;
        int minIdx = 0;
        int maxIdx = n - 1;

        for (int i = 0; i < n; i++) {
            if (i % 2 == 0) {
                arr[i] += (arr[maxIdx] % maxElem) * maxElem;
                maxIdx--;
            } else {
                arr[i] += (arr[minIdx] % maxElem) * maxElem;
                minIdx++;
            }
        }

        for (int i = 0; i < n; i++) {
            arr[i] /= maxElem;
        }
    }
};