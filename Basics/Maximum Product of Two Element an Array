import java.util.*;
class Solution {
    public int maxProduct(int[] nums) {
        int p1;
        int p2;
        int f=0;
        int s=0;
        for(int i=0;i<nums.length;i++){
            
            if(nums[i]>f){
                s=f;
                f=nums[i];
            }else if(nums[i]>s){
                s=nums[i];
            }
        }
        p1= (f-1)*(s-1);
        return p1;
    }
}