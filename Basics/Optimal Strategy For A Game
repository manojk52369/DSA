class Solution {
public:
    int maximumAmount(vector<int>& arr) {
        int n = arr.size();
        vector<vector<int>> dp(n, vector<int>(n, 0));

        for (int gap = 0; gap < n; ++gap) {
            for (int i = 0, j = gap; j < n; ++i, ++j) {
             
                if (gap == 0) {
                    dp[i][j] = arr[i];
                } else if (gap == 1) {
                    dp[i][j] = max(arr[i], arr[j]);
                } else {

                    int pickFirst = arr[i] + min(dp[i + 2][j], dp[i + 1][j - 1]);
                    int pickLast  = arr[j] + min(dp[i + 1][j - 1], dp[i][j - 2]);

                    dp[i][j] = max(pickFirst, pickLast);
                }
            }
        }

        return dp[0][n - 1];
    }
};
