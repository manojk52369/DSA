class Solution {
  public:
    int maximumPoints(vector<vector<int>>& mat) {
        int n = mat.size();
        if (n == 0) return 0;
        
        int prev0 = mat[0][0]; // Ended with Running
        int prev1 = mat[0][1]; // Ended with Fighting
        int prev2 = mat[0][2]; // Ended with Learning
        
        for (int i = 1; i < n; i++) {
            int curr0 = mat[i][0] + max(prev1, prev2);
            int curr1 = mat[i][1] + max(prev0, prev2);
            int curr2 = mat[i][2] + max(prev0, prev1);
            
            prev0 = curr0;
            prev1 = curr1;
            prev2 = curr2;
        }
        
        return max({prev0, prev1, prev2});
    }
};