class Solution {
public:
    void generateSubsets(int index, long long currentProduct, const vector<int>& subArr, int k, vector<long long>& products) {
        if (index == subArr.size()) {
            products.push_back(currentProduct);
            return;
        }

        generateSubsets(index + 1, currentProduct, subArr, k, products);

        if (currentProduct * subArr[index] <= k) {
            generateSubsets(index + 1, currentProduct * subArr[index], subArr, k, products);
        }
    }

    int numOfSubsets(vector<int> &arr, int k) {
        int n = arr.size();
        vector<int> left, right;

        for (int i = 0; i < n; i++) {
            if (i < n / 2) left.push_back(arr[i]);
            else right.push_back(arr[i]);
        }

        vector<long long> productsLeft, productsRight;

        generateSubsets(0, 1, left, k, productsLeft);
        generateSubsets(0, 1, right, k, productsRight);

        sort(productsRight.begin(), productsRight.end());

        int count = 0;

        for (long long pL : productsLeft) {
            long long maxRightVal = k / pL;

            auto it = upper_bound(productsRight.begin(), productsRight.end(), maxRightVal);
            count += (it - productsRight.begin());
        }

        return count - 1;
    }
};