#include <vector>
#include <map>
#include <algorithm>

class Solution {
public:
    int powerfulInteger(std::vector<std::vector<int>>& intervals, int k) {
        // Map to store event changes at specific coordinates
        std::map<int, int> diff;
        
        // Populate the difference map
        for (const auto& interval : intervals) {
            diff[interval[0]] += 1;
            diff[interval[1] + 1] -= 1;
        }
        
        int max_powerful = -1;
        int current_overlap = 0;
        
        // Traverse the map in sorted order of coordinates
        for (auto it = diff.begin(); it != diff.end(); ++it) {
            current_overlap += it->second;
            
            // If the current overlap condition is met
            if (current_overlap >= k) {
                // Peek at the next event's coordinate
                auto next_it = std::next(it);
                if (next_it != diff.end()) {
                    // All integers up to (next_coordinate - 1) are valid
                    max_powerful = std::max(max_powerful, next_it->first - 1);
                }
            }
        }
        
        return max_powerful;
    }
};
