class Solution {
public:
    int maxSweetness(vector<int> &sweetness, int k) {
        long long low = 1;
        long long high = 0;

        for (int x : sweetness)
            high += x;

        int ans = 0;

        while (low <= high) {
            long long mid = low + (high - low) / 2;

            int pieces = 0;
            long long sum = 0;

            for (int x : sweetness) {
                sum += x;

                if (sum >= mid) {
                    pieces++;
                    sum = 0;
                }
            }

            if (pieces >= k + 1) {
                ans = mid;
                low = mid + 1;
            } 
            else {
                high = mid - 1;
            }
        }

        return ans;
    }
};