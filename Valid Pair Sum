class Solution {
public:
    long long ValidPair(int a[], int n) {
        sort(a, a + n);

        long long ans = 0;
        int i = 0, j = n - 1;

        while (i < j) {
            if (a[i] + a[j] > 0) {
                ans += (j - i);
                j--;
            } else {
                i++;
            }
        }

        return ans;
    }
};