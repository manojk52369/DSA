class Solution {
public:
    int digitSum(long long x) {
        int sum = 0;
        while (x > 0) {
            sum += x % 10;
            x /= 10;
        }
        return sum;
    }

    int numberCount(int n, int k) {
        long long low = 0, high = n;
        long long ans = -1;

        while (low <= high) {
            long long mid = low + (high - low) / 2;

            if (mid - digitSum(mid) >= k) {
                ans = mid;
                high = mid - 1;
            } else {
                low = mid + 1;
            }
        }

        if (ans == -1) return 0;
        return n - ans + 1;
    }
};