class Solution {
public:
    int minProductSum(vector<int>& a, vector<int>& b) {
        sort(a.begin(), a.end());
        sort(b.begin(), b.end(), greater<int>());

        long long sum = 0;
        for (int i = 0; i < a.size(); i++) {
            sum += 1LL * a[i] * b[i];
        }

        return (int)sum;
    }
};