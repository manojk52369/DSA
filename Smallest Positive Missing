class Solution {
  public:
    int missingNumber(vector<int> &arr) {
        int n = arr.size();

        // Place every element at its correct position
        for(int i = 0; i < n; i++) {
            while(arr[i] > 0 && arr[i] <= n && arr[arr[i] - 1] != arr[i]) {
                swap(arr[i], arr[arr[i] - 1]);
            }
        }

        // Find first missing positive number
        for(int i = 0; i < n; i++) {
            if(arr[i] != i + 1) {
                return i + 1;
            }
        }

        return n + 1;
    }
};