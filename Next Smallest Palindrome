class Solution {
public:
    vector<int> nextPalindrome(vector<int>& arr) {
        int n = arr.size();
        bool all_nine = true;

        for (int x : arr) {
            if (x != 9) {
                all_nine = false;
                break;
            }
        }

        if (all_nine) {
            vector<int> ans(n + 1, 0);
            ans[0] = 1;
            ans[n] = 1;
            return ans;
        }

        int mid = n / 2;
        int i = mid - 1;
        int j = (n % 2 == 0) ? mid : mid + 1;

        while (i >= 0 && arr[i] == arr[j]) {
            i--;
            j++;
        }

        bool left_smaller = false;
        if (i < 0 || arr[i] < arr[j]) {
            left_smaller = true;
        }

        i = mid - 1;
        j = (n % 2 == 0) ? mid : mid + 1;
        while (i >= 0) {
            arr[j] = arr[i];
            i--;
            j++;
        }

        if (left_smaller) {
            int carry = 1;
            i = mid - 1;

            if (n % 2 != 0) {
                arr[mid] += carry;
                carry = arr[mid] / 10;
                arr[mid] %= 10;
                j = mid + 1;
            } else {
                j = mid;
            }

            while (i >= 0 && carry > 0) {
                arr[i] += carry;
                carry = arr[i] / 10;
                arr[i] %= 10;
                arr[j] = arr[i]; 
                i--;
                j++;
            }
        }

        return arr;
    }
};