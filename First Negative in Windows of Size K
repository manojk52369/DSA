class Solution {
public:
    vector<int> firstNegInt(vector<int>& arr, int k) {
        vector<int> ans;
        queue<int> q;  

        int i = 0, j = 0;
        int n = arr.size();

        while (j < n) {

            if (arr[j] < 0)
                q.push(j);

            if (j - i + 1 < k) {
                j++;
            }
            else {
                while (!q.empty() && q.front() < i)
                    q.pop();

                if (q.empty())
                    ans.push_back(0);
                else
                    ans.push_back(arr[q.front()]);

                i++;
                j++;
            }
        }

        return ans;
    }
};